{
  "meta": {
    "name": "MIGHT OS - Realtime Chat",
    "version": "3.1",
    "author": "Mark Benjamin Douglas"
  },
  "config": {
    "endpoint": "https://ntfy.sh",
    "topic": "might_os_chat_room_99"
  },
  "pipeline": [
    { "cmd": "SYS_CLEAR_SCREEN" },
    { "cmd": "SYS_PRINT", "msg": "\u001b[1;36m==========================================================\u001b[0m" },
    { "cmd": "SYS_PRINT", "msg": "\u001b[1;36m           MIGHT OS Realtime Chat (ntfy.sh)               \u001b[0m" },
    { "cmd": "SYS_PRINT", "msg": "\u001b[1;36m==========================================================\u001b[0m" },
    { "cmd": "SYS_PRINT", "msg": "\u001b[1;33m[*] Connecting to bus...\u001b[0m" },

    {
      "cmd": "SYS_PROMPT_INPUT",
      "var_name": "USER_NICK",
      "prompt": "\u001b[1;35m[?] Nickname: \u001b[0m",
      "default": "MIGHT_User"
    },

    {
      "cmd": "NET_HTTP_POST",
      "url": "${config.endpoint}/${config.topic}",
      "headers": { "Title": "join", "Tags": "incoming" },
      "body": "[SYS] ${USER_NICK} joined the channel"
    },

    { "cmd": "SYS_PRINT", "msg": "\u001b[1;34m=== LIVE (type :q to quit) ===\u001b[0m" },

    {
      "cmd": "NET_START_SSE_THREAD",
      "url": "${config.endpoint}/${config.topic}/raw?poll=0"
    },

    {
      "cmd": "SYS_EVENT_LOOP",
      "label": "CHAT_LOOP",
      "actions": [
        {
          "cmd": "SYS_READ_LINE",
          "var_name": "OUTGOING_MSG",
          "prompt": "\u001b[1;37m${USER_NICK} > \u001b[0m"
        },
        {
          "cmd": "SYS_COND_BREAK",
          "var": "OUTGOING_MSG",
          "equals": ":q"
        },
        {
          "cmd": "SYS_COND_EXEC",
          "var": "OUTGOING_MSG",
          "not_empty": true,
          "then": [
            {
              "cmd": "NET_HTTP_POST",
              "url": "${config.endpoint}/${config.topic}",
              "headers": { "Priority": "3" },
              "body": "<${USER_NICK}> ${OUTGOING_MSG}"
            }
          ]
        }
      ]
    },

    { "cmd": "NET_STOP_SSE_THREAD" },

    {
      "cmd": "NET_HTTP_POST",
      "url": "${config.endpoint}/${config.topic}",
      "headers": { "Title": "leave", "Tags": "outgoing" },
      "body": "[SYS] ${USER_NICK} left the channel"
    },

    { "cmd": "SYS_PRINT", "msg": "\n\u001b[1;33m[*] Bye, ${USER_NICK}.\u001b[0m" }
  ]
}
