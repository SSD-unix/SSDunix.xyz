{
  "meta": {
    "name": "MIGHT OS - Pure JSON Realtime Chat",
    "version": "4.3",
    "author": "Mark Benjamin Douglas"
  },
  "config": {
    "endpoint": "https://ntfy.sh",
    "topic": "gago_chat_2026_x7k9",
    "poll_ms": 1500
  },
  "pipeline": [
    { "cmd": "SYS_CLEAR_SCREEN" },
    { "cmd": "SYS_PRINT", "msg": "\u001b[1;36m==========================================================\u001b[0m" },
    { "cmd": "SYS_PRINT", "msg": "\u001b[1;36m           MIGHT OS Realtime Chat (ntfy.sh)               \u001b[0m" },
    { "cmd": "SYS_PRINT", "msg": "\u001b[1;36m==========================================================\u001b[0m" },
    { "cmd": "SYS_PRINT", "msg": "\u001b[1;33m[*] Connecting to bus...\u001b[0m" },

    {
      "cmd": "SYS_PROMPT_INPUT",
      "var_name": "USER_NICK",
      "prompt": "\u001b[1;35m[?] Nickname: \u001b[0m",
      "default": "MIGHT_User"
    },

    { "cmd": "SYS_SET", "var_name": "LAST_ID",  "value": "" },
    { "cmd": "SYS_SET", "var_name": "POLL_BODY","value": "" },

    {
      "cmd": "NET_HTTP_POST",
      "url": "${config.endpoint}/${config.topic}",
      "headers": { "Title": "join", "Tags": "incoming" },
      "body": "[SYS] ${USER_NICK} joined"
    },

    { "cmd": "SYS_PRINT", "msg": "\u001b[1;34m=== LIVE (type :q to quit) ===\u001b[0m" },

    {
      "cmd": "NET_POLL_THREAD",
      "url": "${config.endpoint}/${config.topic}/json?poll=1&since=${LAST_ID}",
      "into": "POLL_BODY",
      "every_ms": 1500
    },

    {
      "cmd": "SYS_EVENT_LOOP",
      "label": "CHAT_LOOP",
      "actions": [

        {
          "cmd": "SYS_FOREACH_LINE",
          "var": "POLL_BODY",
          "item_var": "LINE",
          "do": [
            { "cmd": "SYS_JSON_GET", "var": "LINE", "path": "id",      "to": "MSG_ID"   },
            { "cmd": "SYS_JSON_GET", "var": "LINE", "path": "event",   "to": "MSG_EVT"  },
            { "cmd": "SYS_JSON_GET", "var": "LINE", "path": "message", "to": "MSG_TEXT" },

            { "cmd": "SYS_COND_EXEC", "var": "MSG_ID", "not_empty": true, "then": [
                { "cmd": "SYS_SET", "var_name": "LAST_ID", "value": "${MSG_ID}" }
            ]},

            { "cmd": "SYS_COND_EXEC", "var": "MSG_TEXT", "not_empty": true, "then": [

              { "cmd": "SYS_COND_CONTAINS", "var": "MSG_TEXT", "contains": "<${USER_NICK}>", "not": true, "then": [

                { "cmd": "SYS_COND_CONTAINS", "var": "MSG_TEXT", "contains": "[SYS] ${USER_NICK}", "not": true, "then": [

                  { "cmd": "SYS_PRINT", "msg": "\r\u001b[K\u001b[1;32m[IN]\u001b[0m ${MSG_TEXT}" },
                  { "cmd": "SYS_PRINT", "msg": "\u001b[1;37m${USER_NICK} > \u001b[0m" }

                ]}
              ]}
            ]}
          ]
        },

        { "cmd": "SYS_SET", "var_name": "POLL_BODY", "value": "" },

        {
          "cmd": "SYS_READ_LINE",
          "var_name": "OUTGOING_MSG",
          "prompt": "\u001b[1;37m${USER_NICK} > \u001b[0m"
        },
        { "cmd": "SYS_COND_BREAK", "var": "OUTGOING_MSG", "equals": ":q" },
        { "cmd": "SYS_COND_EXEC", "var": "OUTGOING_MSG", "not_empty": true, "then": [
            {
              "cmd": "NET_HTTP_POST",
              "url": "${config.endpoint}/${config.topic}",
              "headers": { "Priority": "3" },
              "body": "<${USER_NICK}> ${OUTGOING_MSG}"
            }
        ]}
      ]
    },

    { "cmd": "NET_STOP_POLL_THREAD" },

    {
      "cmd": "NET_HTTP_POST",
      "url": "${config.endpoint}/${config.topic}",
      "headers": { "Title": "leave", "Tags": "outgoing" },
      "body": "[SYS] ${USER_NICK} left"
    },

    { "cmd": "SYS_PRINT", "msg": "\n\u001b[1;33m[*] Bye, ${USER_NICK}.\u001b[0m" }
  ]
}
